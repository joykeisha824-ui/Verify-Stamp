</style>
</head>

<body>

<div class="sidebar">
    <h2>Verify Stamp</h2>
    <a href="dashboard.html">Dashboard</a>
    <a href="issue.html">Issue Credential</a>
    <a href="#">Verification Logs</a>
    <a href="#">Settings</a>
</div>

<div class="main">
    <h1>Institution Dashboard</h1>

    <div class="card">
        <h3>Total Credentials Issued</h3>
        <p id="totalCount">0</p>
    </div>

    <div class="card">
        <h3>Issued Credentials</h3>
        <div id="credentialList"></div>
    </div>
<div class="card">
    <h3>Recent Verification Activity</h3>
    <div id="logList"></div>
</div>

    <button onclick="window.location.href='issue.html'">
        Issue New Credential
    </button>
</div>

<script>
function loadCredentials() {
    let credentials = JSON.parse(localStorage.getItem("credentials")) || [];
    document.getElementById("totalCount").innerText = credentials.length;

    let listHTML = "";

    credentials.forEach(c => {
        listHTML += `
            <div style="margin-bottom:15px;">
                <strong>${c.name}</strong><br>
                ${c.title}<br>
                <small>ID: ${c.id}</small><br>
                <a href="verify.html?id=${c.id}" target="_blank">
                    Verification Link
                </a>
                <hr>
            </div>
        `;
    });

    document.getElementById("credentialList").innerHTML = listHTML;
}

loadCredentials();
</script>
<script>
function loadCredentials() {
    let credentials = JSON.parse(localStorage.getItem("credentials")) || [];
    let logs = JSON.parse(localStorage.getItem("verificationLogs")) || [];

    document.getElementById("totalCount").innerText = credentials.length;

    let listHTML = "";
    credentials.forEach(c => {
        listHTML += `
            <div style="margin-bottom:15px;">
                <strong>${c.name}</strong><br>
                ${c.title}<br>
                <small>ID: ${c.id}</small><br>
                <a href="verify.html?id=${c.id}" target="_blank">
                    Verification Link
                </a>
                <hr>
            </div>
        `;
    });
    document.getElementById("credentialList").innerHTML = listHTML;

    let logHTML = "";
    logs.slice().reverse().forEach(l => {
        logHTML += `
            <div style="margin-bottom:10px;">
                ${l.name}'s credential verified<br>
                <small>${l.time}</small>
                <hr>
            </div>
        `;
    });
    document.getElementById("logList").innerHTML = logHTML;
}

loadCredentials();
</script>

</body>
</html>
