}

/* Sidebar */
.sidebar {
    width:220px;
    background:#111111;
    color:white;
    height:100vh;
    position:fixed;
    padding:30px;
}

.sidebar h2 {
    margin-top:0;
}

.sidebar a {
    display:block;
    color:white;
    text-decoration:none;
    margin-top:20px;
    font-size:14px;
}

/* Main Content */
.main {
    margin-left:240px;
    padding:40px;
}

.card {
    background:white;
    padding:30px;
    border-radius:8px;
    margin-bottom:30px;
    box-shadow:0 5px 15px rgba(0,0,0,0.04);
