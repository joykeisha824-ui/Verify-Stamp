// Set Institution Name
let institution = localStorage.getItem("institutionName");

if (!institution) {
    institution = "University of the District of Columbia";
    localStorage.setItem("institutionName", institution);
}

document.getElementById("institutionName").innerText = institution + " Dashboard";
<!DOCTYPE html>
<html>
<head>
<title>Dashboard - Verify Stamp</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
<style>
body {
    font-family: 'Inter', sans-serif;
    margin:0;
